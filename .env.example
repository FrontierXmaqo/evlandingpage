# Copy this file to .env.local (gitignored) and fill in the real value.
# NEVER prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
# The lead form posts to /api/lead, which reads this server-side and forwards
# the submission to your webhook. The URL itself is never sent to the client.
LEAD_WEBHOOK_URL=

# Supabase project used for the internal CMS (/admin). The anon key is safe
# to expose to the browser (it's what NEXT_PUBLIC_ means) — it only grants
# whatever Row Level Security policies allow. NEVER add the service_role key
# here or anywhere else in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
